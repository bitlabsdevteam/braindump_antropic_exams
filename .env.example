# Configure exactly ONE endpoint. Project mode uses the AI Projects SDK + Entra.
# https://<resource>.services.ai.azure.com/api/projects/<project>
FOUNDRY_PROJECT_ENDPOINT=

# Resource mode uses Microsoft's documented OpenAI SDK connection to Foundry v1.
# https://<resource>.openai.azure.com/openai/v1
FOUNDRY_OPENAI_ENDPOINT=

# Existing deployment name; must support Responses + strict JSON output.
FOUNDRY_MODEL=

# DefaultAzureCredential uses your Azure CLI/Entra sign-in for local development.
# For Azure hosting use managed_identity; optionally set AZURE_CLIENT_ID below
# for a user-assigned identity. Resource mode also supports api_key.
FOUNDRY_CREDENTIAL=default
AZURE_CLIENT_ID=

# Resource mode only: set FOUNDRY_CREDENTIAL=api_key and put the key here.
FOUNDRY_API_KEY=

# Includes reasoning tokens; integer between 512 and 16384.
FOUNDRY_MAX_OUTPUT_TOKENS=4096

# Actual context capacity of the configured deployment; reserves output and schema headroom.
FOUNDRY_CONTEXT_WINDOW_TOKENS=128000
