{
  "name": "claude-cert-practice",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "npm run seed && next dev",
    "build": "npm run seed && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "seed": "node scripts/seed.mjs",
    "tutor:eval": "node agents/ai-tutor/harness/eval.mjs",
    "tutor:traces": "node agents/ai-tutor/harness/traces.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "tutor:eval:live": "node --env-file-if-exists=.env.local --import tsx agents/ai-tutor/harness/live.ts",
    "format": "prettier --write app components lib agents scripts tests prompts docs Readme.md playwright.config.ts package.json",
    "format:check": "prettier --check app components lib agents scripts tests prompts docs Readme.md playwright.config.ts package.json"
  },
  "dependencies": {
    "@azure/ai-projects": "^2.7.1",
    "@azure/identity": "^4.13.3",
    "better-sqlite3": "^11.10.0",
    "next": "^15.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.23"
    }
  }
}
